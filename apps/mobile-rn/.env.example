# What a build points at. `app.config.ts` reads these and hands them to the app
# through Expo's `extra`; `src/config` parses them back.
#
# Copy to `.env` for local development. A build takes them from EAS environment
# variables instead. The anon key is publishable by design — the row-level
# security policies are written against it — so nothing here is a secret.
#
# A missing or empty value fails on launch naming itself, rather than going out
# as a request to `undefined/auth/v1`.
#
# The values below are the ones a LOCAL stack runs on, and they are what the
# Flutter app's own `.vscode/.local.env` uses. Both have to actually be running
# or the app launches fine and every request fails with "Could not connect to
# the server" — see docs/setup.md:
#
#   supabase start              # in apps/supabase, serves :54321
#   dart run bin/server.dart    # in apps/server, serves :8080
#
# `localhost` resolves from the iOS simulator, which shares the host's network.
# A physical device does not: give it the Mac's LAN address instead.
#
# Point these at the deployed Supabase project and token server to run against
# production data.

SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPPORT_EMAIL=

# Lumy's YNAB OAuth application. The client secret is not here and never is:
# the code exchange happens on apps/server, which holds it.
#
# `YNAB_CLIENT_ID` is `CLIENT_ID` in the Flutter app's env file; the other two
# names are the same in both.
YNAB_CLIENT_ID=
YNAB_AUTHORIZE_URL=https://app.ynab.com/oauth/authorize
YNAB_TOKEN_URL=http://localhost:8080
