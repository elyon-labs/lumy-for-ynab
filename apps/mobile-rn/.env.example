# What a build points at. `app.config.ts` reads these and hands them to the app
# through Expo's `extra`; `src/config` parses them back.
#
# Copy to `.env` for local development. A build takes them from EAS environment
# variables instead. The anon key is publishable by design — the row-level
# security policies are written against it — so nothing here is a secret.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPPORT_EMAIL=

# Lumy's YNAB OAuth application. The client secret is not here and never is:
# the code exchange happens on apps/server, which holds it.
YNAB_CLIENT_ID=
YNAB_AUTHORIZE_URL=https://app.ynab.com/oauth/authorize
YNAB_TOKEN_URL=
