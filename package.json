{
  "name": "lumy",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "mobile": "pnpm --dir apps/mobile-rn",
    "mobile:start": "pnpm --dir apps/mobile-rn start",
    "mobile:ios": "pnpm --dir apps/mobile-rn ios",
    "mobile:ios:device": "pnpm --dir apps/mobile-rn ios:device",
    "mobile:android": "pnpm --dir apps/mobile-rn android",
    "mobile:lint": "pnpm --dir apps/mobile-rn lint",
    "mobile:test": "pnpm --dir apps/mobile-rn test",
    "mobile:typecheck": "pnpm --dir apps/mobile-rn typecheck",
    "theme": "pnpm --dir packages/theme",
    "theme:test": "pnpm --dir packages/theme test",
    "theme:typecheck": "pnpm --dir packages/theme typecheck",
    "ui": "pnpm --dir packages/ui",
    "ui:lint": "pnpm --dir packages/ui lint",
    "ui:typecheck": "pnpm --dir packages/ui typecheck",
    "eslint-plugin:test": "pnpm --dir packages/eslint-plugin test",
    "money": "pnpm --dir packages/money",
    "money:test": "pnpm --dir packages/money test",
    "money:typecheck": "pnpm --dir packages/money typecheck",
    "data": "pnpm --dir packages/data",
    "data:test": "pnpm --dir packages/data test",
    "data:typecheck": "pnpm --dir packages/data typecheck",
    "web:dev": "pnpm --dir marketing-site dev",
    "web:build": "pnpm --dir marketing-site build",
    "web:preview": "pnpm --dir marketing-site preview",
    "lint": "pnpm ui:lint && pnpm mobile:lint",
    "test": "pnpm eslint-plugin:test && pnpm theme:test && pnpm money:test && pnpm data:test && pnpm mobile:test",
    "typecheck": "pnpm theme:typecheck && pnpm money:typecheck && pnpm data:typecheck && pnpm ui:typecheck && pnpm mobile:typecheck"
  },
  "pnpm": {
    "overrides": {
      "semver": "7.8.1"
    }
  }
}
