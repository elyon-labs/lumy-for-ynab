---
const { rating = 0, maxRating = 5 } = Astro.props;
---

<div class="star-rating">
    {
        Array.from({ length: maxRating }).map((_, index) => (
            <svg
                class={`star ${index < rating ? "filled" : ""}`}
                viewBox="0 0 24 24"
                fill="currentColor"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
            </svg>
        ))
    }
</div>

<style>
    .star-rating {
        display: flex;
    }
    .star {
        width: 24px;
        height: 24px;
        margin-right: 4px;
        color: #d3d3d3; /* Default star color */
    }
    .star.filled {
        color: #ffcc00; /* Filled star color */
    }
</style>
